# Local RootにはAWS Providerが存在しない.
kubeconfig_path    = "~/.kube/config"
kubeconfig_context = null

public_api_image         = "registry.example.invalid/game/public-api:CHANGE_ME"
game_server_image        = "registry.example.invalid/game/game-server:CHANGE_ME"
coordinator_image        = "registry.example.invalid/game/guild-battle-coordinator:CHANGE_ME"
game_server_scaler_image = "registry.example.invalid/game/game-server-scaler:CHANGE_ME"


# Port番号はApplication実装と一致する値へ変更する. 0のままApplyしない.
public_api_port          = 0
game_server_port         = 0
game_server_control_port = 0
scaler_control_port      = 0
private_api_port         = 0

# Application固有の設定Keyは仕様/実装に合わせてここへ定義する. Terraform ModuleではKey名を仮定しない.
public_api_env           = {}
game_server_env          = {}
coordinator_env          = {}
game_server_scaler_env   = {}

# Kubernetes volumeMountは絶対Pathが必要なため, ApplicationのWorking Directoryに合わせて明示する.
replay_mount_path = "/CHANGE_ME/log/guild_battle"

private_api_cidr     = "192.0.2.10/32"
# Kubernetes API Serverの実到達先CIDRへ変更する.
kubernetes_api_cidr  = "CHANGE_ME/32"

# Secret本体をTerraform変数へ入れない. 事前作成済みSecret名だけを指定する.
mtls_secret_public_api  = "public-api-mtls"
mtls_secret_game_server = "game-server-mtls"
mtls_secret_coordinator = "coordinator-mtls"
mtls_secret_scaler      = "game-server-scaler-mtls"

# 物理Server 1台の範囲を超えない値に設定する.
public_api_max_replicas  = 4

game_server_storage_class_name = null
